{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "btd6-save-state-manager",
  "version": "0.1.0",
  "identifier": "dev.thomas.btd6-save-state-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BTD6 Save State Manager",
        "label": "main",
        "width": 380,
        "height": 520,
        "minWidth": 320,
        "minHeight": 320,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
